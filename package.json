{
  "name": "riadthreads",
  "private": true,
  "version": "0.1.0",
  "description": "Riad Threads wholesale showcase, enquiry funnel and admin dashboard",
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "pnpm --filter @riad/api dev",
    "dev:worker": "pnpm --filter @riad/api dev:worker",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "seed:admin": "pnpm --filter @riad/api seed:admin",
    "seed:demo": "pnpm --filter @riad/api seed:demo",
    "seed:catalogue": "pnpm --filter @riad/api seed:catalogue",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  }
}
