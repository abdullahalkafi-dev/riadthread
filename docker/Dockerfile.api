# Image for the API and the worker. The same image runs both:
#   api:    node dist/server.js   (default)
#   worker: node dist/worker.js
FROM node:22-bookworm-slim AS base
RUN npm install -g pnpm@12.15.0
WORKDIR /repo

# ---- build: install everything, then bundle the API
FROM base AS build
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @riad/api...
COPY packages packages
COPY apps/api apps/api
RUN pnpm --filter @riad/api build

# ---- runtime: production dependencies only, plus ffmpeg for video posters
FROM base AS runtime
ENV NODE_ENV=production
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --prod --filter @riad/api...
COPY --from=build /repo/apps/api/dist apps/api/dist
COPY docker/healthcheck.cjs /healthcheck.cjs
WORKDIR /repo/apps/api
USER node
EXPOSE 4000
# Works for both roles: the API answers /api/health, the worker keeps a heartbeat file fresh.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD ["node", "/healthcheck.cjs"]
CMD ["node", "dist/server.js"]
