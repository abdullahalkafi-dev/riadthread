# Where the web server reaches the API (server-side only).
API_URL=http://localhost:4000
# Same value as INTERNAL_API_SECRET in the API's .env, so server-side calls skip per-IP rate limits.
INTERNAL_API_SECRET=
# Public address of the site (canonical URLs, sitemap, Open Graph).
SITE_URL=http://localhost:3000
# true on staging, so search engines ignore it.
NOINDEX=true
# Shared with the API's REVALIDATE_SECRET: lets the API refresh pages after a publish.
REVALIDATE_SECRET=
# Public storage bucket that /media is proxied to.
MEDIA_ORIGIN=http://localhost:8333/riad-public
