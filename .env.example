# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

SITE_URL=http://localhost:3000
CORS_ORIGINS=
TRUST_PROXY=false
NOINDEX=true

COOKIE_SECURE=false
COOKIE_DOMAIN=
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# Seeded on first start (pnpm seed:admin). Change the password in the dashboard afterwards.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password-of-10-or-more-characters

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=riadthreads
S3_SECRET_KEY=riadthreads-secret
S3_BUCKET_PRIVATE=riad-private
S3_BUCKET_PUBLIC=riad-public
MEDIA_BASE_URL=/media

# Empty = e-mails are written to the log instead of being sent.
# Gmail example: smtps://you%40gmail.com:<app-password>@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Riad Threads <no-reply@localhost>
# Who hears about new leads until addresses are saved in Settings (comma-separated).
NOTIFY_EMAILS=

# Empty = the captcha check is skipped (development only).
TURNSTILE_SECRET=

# Set once the web app exists so publishing can refresh the site.
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Sent by the web server as x-internal-key so its API calls skip the per-IP rate limits.
INTERNAL_API_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
